# ── Job Copilot — variables de entorno ─────────────────────────
# Base de datos (SQLite para desarrollo, PostgreSQL en Docker/producción)
DATABASE_URL=sqlite:///./job-copilot.db
# DATABASE_URL=postgresql+psycopg://job:job@localhost:5432/jobcopilot

# Orígenes permitidos para el frontend (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sembrar datos demo al arrancar (perfil y postulaciones de ejemplo)
SEED_ON_STARTUP=false

# ── IA ──────────────────────────────────────────────────────────
# auto = usa la primera clave disponible (OpenAI-compatible > Gemini).
# Sin claves configuradas, la app usa un motor heurístico local (funciona igual).
LLM_PROVIDER=auto

# Cualquier API compatible con OpenAI: OpenAI, Groq, OpenRouter, Together,
# Ollama, LM Studio, OmniRoute… (gratis con límite en varias)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini → clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
